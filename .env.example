# Jharkhand Societal Innovation & Collaboration Portal
# Environment Configuration Template

# Server settings
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="Jharkhand Societal Innovation & Collaboration Portal"

# JWT Security
SECRET_KEY=jharkhand-sih-2026-societal-innovation-secret-key-987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration:
# Default zero-setup SQLite database for local evaluation:
DATABASE_URL=sqlite:///./portal.db

# For PostgreSQL in Production / Enterprise Deployment:
# DATABASE_URL=postgresql://jharkhand_admin:jharkhand_pass@localhost:5432/jharkhand_innovation_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File upload storage directory
UPLOAD_DIR=./uploads
